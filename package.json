{
  "name": "tiny-speech",
  "version": "0.3.0",
  "private": true,
  "description": "Private, in-browser voice questions and answers in English and Mexican Spanish: 8.9 MB speech-to-text (tiny ears), a rule-based reader and an 8 MB voice (MX1, built on tiny-voca by Muhammed Nazeem).",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "test:live": "node test/live/real-models.mjs",
    "fetch:voice": "node tools/fetch-voice.mjs",
    "fetch:voice-orig": "NODE_USE_ENV_PROXY=1 node tools/voice-gguf.mjs init",
    "voice:data": "NODE_USE_ENV_PROXY=1 node tools/voice-data.mjs"
  },
  "devDependencies": {
    "playwright": "^1.50.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/larsboesen-prog/tiny-speech"
  }
}
